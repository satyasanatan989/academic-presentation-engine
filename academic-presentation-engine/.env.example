# Environment Configuration Example
# Copy to .env and configure if external cloud APIs are desired.
# The system functions without paid keys using open academic APIs and local PowerPoint COM.

# Academic Search Contact (OpenAlex / Crossref polite pool)
ACADEMIC_POLITE_EMAIL=user@example.edu

# Optional external LLM API (Default uses Antigravity harness)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Engine Logging
LOG_LEVEL=INFO
LOW_MEMORY_MODE=true
